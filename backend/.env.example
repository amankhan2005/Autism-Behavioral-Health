# ---- Runtime ----
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/abh
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/abh?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/abh

# ---- CORS (comma-separated origins allowed to call the API) ----
CLIENT_ORIGIN=http://localhost:5173

# ---- Email (Resend) ----
# Leave RESEND_API_KEY blank in dev to skip sending (submissions still save).
RESEND_API_KEY=
EMAIL_FROM="Autism & Behavioral Health <noreply@autismbehavioralhealth.com>"
EMAIL_ADMIN=intake@autismbehavioralhealth.com

# ---- Rate limiting (per IP) ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=8
